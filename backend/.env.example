# RESILIENCE AI Backend Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Admin Authentication & Security
JWT_SECRET=resilience_ai_secure_jwt_secret_key_production_2026
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@resilience.gov.in
ADMIN_PASSWORD=ResilienceAdmin#2026

# Supabase PostgreSQL & Storage Configuration
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key
STORAGE_BUCKET=disaster-reports

# Google Gemini AI Configuration
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

